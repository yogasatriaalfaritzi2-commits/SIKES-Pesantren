# .env.example - Contoh Konfigurasi SIKES Pondok Pesantren
# Salin file ini menjadi .env lalu sesuaikan nilainya

APP_NAME="SIKES Pondok Pesantren"
APP_ENV=development
APP_VERSION=17.0
APP_DEBUG=true

# Konfigurasi Database MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sikes_pondok
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Konfigurasi Fitur AI (Groq / Llama 3)
AI_ENABLED=true
AI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=your_groq_api_key_here
AI_MODEL=llama-3.3-70b-versatile
AI_CHAT_MODEL=llama-3.1-8b-instant
AI_MAX_TOKENS=700
AI_TIMEOUT=45
AI_CHAT_HISTORY_MAX=12

# Keamanan & Session
SESSION_NAME=SIKES_SESSION
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=300
APP_TIMEZONE=Asia/Jakarta
